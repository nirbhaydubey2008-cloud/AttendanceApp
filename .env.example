# ============================================================================
# Multimodal Attendance & Engagement Agent — Environment Configuration
# ============================================================================
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env
# ============================================================================

# Database Configuration (SQLite default, local file)
DATABASE_URL=sqlite:///./attendance.db

# Camera / Video Stream Configuration
# Default 0 is the primary system webcam; or supply an RTSP URL / test video path
CAMERA_ID=0
FRAME_WIDTH=640
FRAME_HEIGHT=480
FPS=30

# Audio Processing Configuration
AUDIO_SAMPLE_RATE=16000
AUDIO_CHUNK_DURATION_SEC=2.0
SPEECH_ENERGY_THRESHOLD=0.015

# Backend API Configuration
API_HOST=127.0.0.1
API_PORT=8000
API_DEBUG=False

# Streamlit Dashboard Configuration
STREAMLIT_HOST=127.0.0.1
STREAMLIT_PORT=8501

# Privacy & Retention Configuration
STORE_RAW_VIDEO=False
RETENTION_DAYS=30

# Optional: Cloud LLM Provider (Disabled by default; core system runs offline rules)
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=mixtral-8x7b-32768
